APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ═══ البريد المركزي لمُداوَلة ═══
#
# المُرسِل واحدٌ لكل المكاتب: بريد مُداوَلة المركزي. واسمُ المكتب يظهر
# في الاسم المعروض، وبريدُه في Reply-To — لأنّ Gmail لا يسمح بالإرسال
# باسم عنوانٍ لا يملكه الحساب المُصادَق.
#
# MAIL_PASSWORD هو App Password من Google (١٦ حرفاً)، لا كلمة مرور
# حساب Gmail. يُولَّد من: حساب Google ← الأمان ← التحقق بخطوتين ←
# كلمات مرور التطبيقات. ولا يُكتب في أي ملف يدخل Git — هذا الملف
# قالبٌ فارغ، والقيمة الحقيقية في .env على الخادم وحده.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=mudawalah@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="mudawalah@gmail.com"
MAIL_FROM_NAME="مُداوَلة"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-2.5-flash

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=

DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_LOG_WEBHOOK=
DISCORD_MONITOR_WEBHOOK=

VITE_APP_NAME="${APP_NAME}"

# ربط اقتراحات الموظفين بلوحة مُداوَلة (اختياري — يُترك فارغاً فلا شيء يتغيّر)
PANEL_INGEST_URL=
PANEL_INGEST_TOKEN=

# اسم المكتب وبياناته في الصفحات العامة — يضبطها كل مكتب لنفسه
# اتركها معلّقة ليظهر النص الافتراضي، أو أزل # واكتب قيمتك
#MARKETING_OFFICE_NAME="مكتب المحاماة"
#MARKETING_PHONE="+968 00000000"
#MARKETING_EMAIL="info@example.om"
#MARKETING_ADDRESS="مسقط، سلطنة عُمان"

# نطاق مُداوَلة الظاهر للمكتب
MUDAWALA_URL=https://mudawala.riyami.om
